# Variáveis da apresentação no PC (deploy/apresentacao/docker-compose.apresentacao.yml).
# iniciar-apresentacao.ps1 gera o .env.apresentacao na primeira execução, com segredos aleatórios fortes escritos
# direto no arquivo (nada aparece na tela). NUNCA versione o .env.apresentacao. Este exemplo não tem valores reais.

# --- Banco (PostgreSQL no contêiner; o volume medcare_apresentacao_pgdata guarda os dados) ---
POSTGRES_USER=medcare_apresentacao
POSTGRES_PASSWORD=
POSTGRES_DB=medcare_db

# --- JWT (64 caracteres aleatórios; o perfil prod recusa segredo curto ou o padrão de desenvolvimento) ---
JWT_SECRET=

# --- Documentação da API: desligada (404) ---
SWAGGER_ENABLED=false

# --- Jobs e regras (padrões atuais do application.yml) ---
JOBS_ENABLED=true
APP_TIMEZONE=America/Sao_Paulo
DOSES_HORIZONTE_DIAS=30
ALERTAS_MARGEM_POS_AVISO_MINUTOS=30
CACHE_RELATORIO_DIARIO_SEGUNDOS=30
DESCONEXAO_VALIDADE_HORAS=24
FCM_DRY_RUN=false

# --- Pool de conexões (PC com pouca memória) ---
DB_POOL_MAX=4
DB_POOL_MIN_IDLE=1
