# Variáveis de PRODUÇÃO do deploy/docker-compose.prod.yml. Copie para deploy/.env.prod NA VM e preencha.
# NUNCA versione o .env.prod nem cole os valores em chat, issue ou commit. Este arquivo de exemplo não tem valores reais.

# --- Domínio (DuckDNS ou outro) usado pelo nginx e pelo certificado ---------------------------------------------------
# Ex.: seu-subdominio.duckdns.org (sem https://)
DOMINIO=

# --- Banco (PostgreSQL no contêiner; o volume pgdata guarda os dados) ------------------------------------------------
POSTGRES_USER=
# Senha forte gerada na VM, por exemplo:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=medcare_db

# --- JWT ---------------------------------------------------------------------------------------------------------------
# Obrigatório, com 32 caracteres ou mais e diferente do padrão de desenvolvimento. Gere com:  openssl rand -base64 48
JWT_SECRET=

# --- Imagem do backend no GitHub Container Registry ----------------------------------------------------------------------
# latest ou o SHA curto de um commit do main (recomendado para poder voltar a versão)
IMAGE_TAG=latest

# --- Avisos por push (Firebase Cloud Messaging) -------------------------------------------------------------------------
# true só com o arquivo deploy/segredos/firebase-adminsdk.json presente na VM. Com false os avisos NÃO são entregues:
# cada aviso fica registrado como falha com motivo PUSH_DESLIGADO.
FCM_ENABLED=false
# true = o Firebase valida, mas não entrega (para testar a credencial)
FCM_DRY_RUN=false

# --- Documentação da API (Swagger UI e /v3/api-docs) ----------------------------------------------------------------------
# false (padrão no perfil prod): /swagger-ui e /v3/api-docs respondem 404. true: ficam PÚBLICOS, sem token, em
# https://DOMINIO/swagger-ui/index.html (só a documentação; as rotas da API continuam exigindo token). Ligue só quando
# precisar mostrar a API, e desligue depois. Ver docs/api/README.md.
SWAGGER_ENABLED=false

# --- Jobs (varredura de doses, retentativa, reabastecimento) ----------------------------------------------------------
# Opcionais (padrões ao lado): a dose encerra em horário + tolerância + ALERTAS_MARGEM_POS_AVISO_MINUTOS (30);
# doses geradas DOSES_HORIZONTE_DIAS à frente (30, de 1 a 90); relatório diário em cache por CACHE_RELATORIO_DIARIO_SEGUNDOS (30)
# ALERTAS_MARGEM_POS_AVISO_MINUTOS=30
# DOSES_HORIZONTE_DIAS=30
# CACHE_RELATORIO_DIARIO_SEGUNDOS=30
JOBS_ENABLED=true
APP_TIMEZONE=America/Sao_Paulo

# --- Memória ----------------------------------------------------------------------------------------------------------------
# VM AMD micro (1 GB): 640m para o backend; VM Ampere A1 (até 24 GB): pode subir (ex.: 2g). Ver docs/capacidade.md
BACKEND_MEM_LIMIT=640m
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# Pool de conexões com o banco: 8 na Ampere A1, 4 na AMD micro (ver docs/capacidade.md)
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=2

# --- nginx ---------------------------------------------------------------------------------------------------------------------
# http-inicial só até emitir o certificado; depois https
NGINX_MODO=http-inicial
