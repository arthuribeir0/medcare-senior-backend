# Variante FINAL: HTTP só redireciona para HTTPS (e serve a renovação do certificado); HTTPS faz proxy para o backend.
# O nginx da imagem oficial troca ${DOMINIO} pelo valor da variável de ambiente ao subir (as variáveis do nginx, com $
# sem chaves, ficam intactas).

# Limite por IP contra rajadas (o pareamento ainda tem o limite próprio do backend)
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

upstream medcare_backend {
    server backend:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};
    include /etc/nginx/snippets/seguranca.conf;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-saude {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/seguranca.conf;
    # Só no HTTPS: o navegador/cliente passa a usar HTTPS por 1 ano
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /nginx-saude {
        access_log off;
        return 200 "ok\n";
    }

    # Só a API e a saúde mínima vão para o backend; o resto responde 404 aqui
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://medcare_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Sobrescreve (não acrescenta): o cliente não consegue forjar o próprio IP
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location = /actuator/health {
        proxy_pass http://medcare_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404;
    }
}
