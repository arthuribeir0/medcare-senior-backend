# Variante FINAL: HTTP só redireciona para HTTPS (e serve a renovação do certificado); HTTPS faz proxy para o backend.
# O nginx da imagem oficial troca ${DOMINIO} pelo valor da variável de ambiente ao subir (as variáveis do nginx, com $
# sem chaves, ficam intactas).

# Limite por IP contra abuso (o pareamento ainda tem o limite próprio do backend). Folgado o bastante para as telas
# "Todos", que pedem em paralelo os idosos e os remédios de cada um.
#
# Isenção para o teste de carga (desligada por padrão): os IPs listados em carga-isenta.conf (vazio no repositório)
# ficam com a chave vazia, e o nginx não conta requisições com chave vazia. Todos os outros IPs seguem o limite.
geo $carga_isenta {
    default 0;
    include /etc/nginx/snippets/carga-isenta.conf;
}

map $carga_isenta $limite_api_chave {
    1 "";
    default $binary_remote_addr;
}

limit_req_zone $limite_api_chave zone=api:10m rate=20r/s;

upstream medcare_backend {
    server backend:8080;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMINIO};
    include /etc/nginx/snippets/seguranca.conf;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-saude {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/seguranca.conf;
    # Só no HTTPS: o navegador/cliente passa a usar HTTPS por 1 ano
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /nginx-saude {
        access_log off;
        return 200 "ok\n";
    }

    # Só a API e a saúde mínima vão para o backend; o resto responde 404 aqui
    location /api/ {
        limit_req zone=api burst=80 nodelay;
        limit_req_status 429;
        error_page 429 = @limite;
        proxy_pass http://medcare_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Sobrescreve (não acrescenta): o cliente não consegue forjar o próprio IP
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        # O Spring Security já manda estes dois: ficam só os do nginx (sem cabeçalho duplicado)
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }

    location = /actuator/health {
        proxy_pass http://medcare_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
    }

    # 429 no mesmo formato de erro da API (o app mostra a mensagem do código LIMITE_TENTATIVAS)
    location @limite {
        default_type application/json;
        # add_header aqui desliga a herança: repete os cabeçalhos de segurança (o snippet tem diretivas só de server)
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Retry-After 2 always;
        return 429 '{"codigo":"LIMITE_TENTATIVAS","mensagem":"Muitas requisições em pouco tempo. Aguarde alguns segundos.","campos":[]}';
    }

    location / {
        return 404;
    }
}
