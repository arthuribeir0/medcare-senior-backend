<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Cadastra tratamento com horários em volta de agora">
<boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
<elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
  <elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;dataInicio&quot;:&quot;${hoje}&quot;,&quot;horarios&quot;:[${horarios}],&quot;diasSemana&quot;:[&quot;MONDAY&quot;,&quot;TUESDAY&quot;,&quot;WEDNESDAY&quot;,&quot;THURSDAY&quot;,&quot;FRIDAY&quot;,&quot;SATURDAY&quot;,&quot;SUNDAY&quot;]}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
</collectionProp></elementProp>
<stringProp name="HTTPSampler.path">/api/medicamentos/${medicamentoId}/tratamentos</stringProp><stringProp name="HTTPSampler.method">POST</stringProp>
<boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
</HTTPSamplerProxy>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Horários em volta de agora">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Horários a cada 5 minutos, de 55 minutos antes a 55 depois de agora, no fuso do backend (propriedade fuso).
// Ficam no mesmo dia: perto da meia-noite, a lista é cortada (rode a preparação longe da virada do dia).
def zona = java.time.ZoneId.of(props.getProperty('fuso', 'America/Sao_Paulo'))
def agora = java.time.ZonedDateTime.now(zona)
def base = agora.withSecond(0).withNano(0).withMinute((int) (agora.getMinute() / 5) * 5)
def lista = (-11..11).collect { base.plusMinutes(it * 5) }.findAll { it.toLocalDate() == agora.toLocalDate() }
vars.put('horarios', lista.collect { '&quot;' + it.toLocalTime().toString() + '&quot;' }.join(','))
vars.put('hoje', agora.toLocalDate().toString())</stringProp>
</JSR223PreProcessor>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
</hashTree>
</hashTree>
</jmeterTestPlan>
