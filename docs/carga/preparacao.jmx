<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MedCare - preparação da massa de carga">
<stringProp name="TestPlan.comments">Cria contas de teste isoladas (prefixo+N@exemplo.invalid). Rode antes de carga.jmx, com -Jcuidadores igual ao do teste.</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
<collectionProp name="Arguments.arguments">
  <elementProp name="protocolo" elementType="Argument"><stringProp name="Argument.name">protocolo</stringProp><stringProp name="Argument.value">${__P(protocolo,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
  <elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
  <elementProp name="porta" elementType="Argument"><stringProp name="Argument.name">porta</stringProp><stringProp name="Argument.value">${__P(porta,8080)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
  <elementProp name="prefixo" elementType="Argument"><stringProp name="Argument.name">prefixo</stringProp><stringProp name="Argument.value">${__P(prefixo,carga)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
  <elementProp name="senha" elementType="Argument"><stringProp name="Argument.name">senha</stringProp><stringProp name="Argument.value">${__P(senha,CargaSomente1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
</collectionProp>
</elementProp>
</TestPlan>
